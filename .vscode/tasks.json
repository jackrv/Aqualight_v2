{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AquaLight: Собрать и отправить в Telegram",
      "type": "process",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["${workspaceFolder}/scripts/send_firmware.py", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "AquaLight: Только сборка и проверка",
      "type": "process",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["${workspaceFolder}/scripts/send_firmware.py", "--build", "--dry-run"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
